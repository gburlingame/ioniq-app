source "https://rubygems.org"

# Mirrors the gem set GitHub Pages uses to build this site, so local builds
# match production (includes jekyll-remote-theme for the just-the-docs remote_theme).
gem "github-pages", group: :jekyll_plugins

# Required to `jekyll serve` on Ruby 3+ (webrick was removed from stdlib).
gem "webrick", "~> 1.8"
